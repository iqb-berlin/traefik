## Version
IQB_TRAEFIK_VERSION_TAG=latest

## Server
SERVER_NAME=base_domain.org

## Ports
HTTP_PORT=80
HTTPS_PORT=443

## TLS Certificates Resolvers
# Leave it empty, if you handle certificates manually, or
# choose 'acme', if you want to use an acme-provider, like 'Let's Encrypt' or 'Sectigo'
TLS_CERTIFICATE_RESOLVER=
TLS_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
TLS_ACME_EAB_KID=
TLS_ACME_EAB_HMAC_ENCODED=
TLS_ACME_EMAIL=admin.name@organisation.org

## Network
# Default is 1500, but Openstack currently uses 1442
DOCKER_DAEMON_MTU=1500

## Super User
ADMIN_NAME=admin
ADMIN_EMAIL=admin@iqb.hu-berlin.de
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_CREATED_TIMESTAMP=1700241453000

## OAuth2 Authentication (OpenID Connect)
# Keycloak DB
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=keycloak

# OAuth2 Clients
# Use unique, strong values per environment.
# Example cookie secret generator:
# openssl rand -base64 32 | tr '+/' '-_'
TRAEFIK_CLIENT_ID=traefik-oauth
TRAEFIK_CLIENT_SECRET=CHANGE_ME_TRAEFIK_CLIENT_SECRET
TRAEFIK_COOKIE_SECRET=CHANGE_ME_TRAEFIK_COOKIE_SECRET
TRAEFIK_EMAIL_DOMAIN=iqb.hu-berlin.de

GRAFANA_CLIENT_ID=grafana-oauth
GRAFANA_CLIENT_SECRET=CHANGE_ME_GRAFANA_CLIENT_SECRET

PROMETHEUS_CLIENT_ID=prometheus-oauth
PROMETHEUS_CLIENT_SECRET=CHANGE_ME_PROMETHEUS_CLIENT_SECRET
PROMETHEUS_COOKIE_SECRET=CHANGE_ME_PROMETHEUS_COOKIE_SECRET
PROMETHEUS_EMAIL_DOMAIN=iqb.hu-berlin.de

NODE_EXPORTER_CLIENT_ID=node-exporter-oauth
NODE_EXPORTER_CLIENT_SECRET=CHANGE_ME_NODE_EXPORTER_CLIENT_SECRET
NODE_EXPORTER_COOKIE_SECRET=CHANGE_ME_NODE_EXPORTER_COOKIE_SECRET
NODE_EXPORTER_EMAIL_DOMAIN=iqb.hu-berlin.de

CADVISOR_CLIENT_ID=cadvisor-oauth
CADVISOR_CLIENT_SECRET=CHANGE_ME_CADVISOR_CLIENT_SECRET
CADVISOR_COOKIE_SECRET=CHANGE_ME_CADVISOR_COOKIE_SECRET
CADVISOR_EMAIL_DOMAIN=iqb.hu-berlin.de

DOZZLE_CLIENT_ID=dozzle-oauth
DOZZLE_CLIENT_SECRET=CHANGE_ME_DOZZLE_CLIENT_SECRET
DOZZLE_COOKIE_SECRET=CHANGE_ME_DOZZLE_COOKIE_SECRET
DOZZLE_EMAIL_DOMAIN=iqb.hu-berlin.de
